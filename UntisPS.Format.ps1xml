<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>UntisPS.TimetableEntry</Name>
      <ViewSelectedBy><TypeName>UntisPS.TimetableEntry</TypeName></ViewSelectedBy>
      <GroupBy>
        <ScriptBlock>$_.Date.ToString('dddd, yyyy-MM-dd')</ScriptBlock>
        <Label>Date</Label>
      </GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Start</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>End</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Subject</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Teacher</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Room</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Class</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>$_.StartTime.ToString('HH:mm')</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.EndTime.ToString('HH:mm')</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Subject</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Teacher</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Room</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Class</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>UntisPS.Change</Name>
      <ViewSelectedBy><TypeName>UntisPS.Change</TypeName></ViewSelectedBy>
      <GroupBy>
        <ScriptBlock>$_.Date.ToString('dddd, yyyy-MM-dd')</ScriptBlock>
        <Label>Date</Label>
      </GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Start</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>End</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Change</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>Subject</Label><Width>12</Width></TableColumnHeader>
          <TableColumnHeader><Label>Class</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Teacher</Label><Width>18</Width></TableColumnHeader>
          <TableColumnHeader><Label>Room</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Text</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>$_.StartTime.ToString('HH:mm')</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.EndTime.ToString('HH:mm')</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>ChangeType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Subject</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Class</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.OriginalTeacher) { "$($_.OriginalTeacher) -> $($_.Teacher)" } else { $_.Teacher }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.OriginalRoom) { "$($_.OriginalRoom) -> $($_.Room)" } else { $_.Room }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Text</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>UntisPS.Exam</Name>
      <ViewSelectedBy><TypeName>UntisPS.Exam</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Date</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Start</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>End</Label><Width>5</Width></TableColumnHeader>
          <TableColumnHeader><Label>Subject</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label><Width>20</Width></TableColumnHeader>
          <TableColumnHeader><Label>Class</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Room</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>$_.Date.ToString('yyyy-MM-dd')</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.StartTime.ToString('HH:mm')</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.EndTime.ToString('HH:mm')</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Subject</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ExamType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Class</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Room</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>UntisPS.Lesson</Name>
      <ViewSelectedBy><TypeName>UntisPS.Lesson</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Subject</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Teacher</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Class</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Periods</Label><Width>7</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Cancelled</Label><Width>9</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Next</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Subject</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Teacher</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Class</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>PeriodCount</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CancelledCount</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.NextPeriod) { $_.NextPeriod.ToString('yyyy-MM-dd HH:mm') }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>UntisPS.Resource</Name>
      <ViewSelectedBy><TypeName>UntisPS.Resource</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label><Width>8</Width><Alignment>Right</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>LongName</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>LongName</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>UntisPS.DiagnosticResult</Name>
      <ViewSelectedBy><TypeName>UntisPS.DiagnosticResult</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Step</Label><Width>15</Width></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Message</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Step</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Message</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
